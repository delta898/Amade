---
import '../styles/global.css';

const siteName = {{site.name.json}};
const siteNameAttribute = siteName
  .replaceAll('&', '&amp;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#39;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');
const navigation = [
  { label: '소개', href: '#about' },
  { label: '우리가 하는 일', href: '#work' },
  { label: '인사이트', href: '#insights' },
  { label: '문의', href: '#contact' },
];
const principles = [
  { number: '01', title: '좋은 질문에서 시작합니다', description: '무엇을 만들지보다 누구를 위해, 왜 필요한지 먼저 살펴봅니다.' },
  { number: '02', title: '작게 만들고 함께 다듬습니다', description: '빠르게 확인하고 꾸준히 개선하며 더 나은 답을 찾아갑니다.' },
  { number: '03', title: '오래 쓰이는 경험을 생각합니다', description: '처음의 인상뿐 아니라 매일 만나는 순간까지 세심하게 설계합니다.' },
];
const stories = [
  { category: '관점', title: '좋은 시작은 언제나 선명한 질문에서', description: '우리가 중요하게 생각하는 가치와 일하는 방식을 소개합니다.', number: '01' },
  { category: '만드는 일', title: '아이디어를 경험으로 바꾸는 과정', description: '작은 단서가 실제 변화로 이어지는 여정을 살펴봅니다.', number: '02' },
  { category: '인사이트', title: '더 나은 내일을 위한 작은 발견', description: '꾸준히 관찰하고 배운 것을 새로운 시선으로 나눕니다.', number: '03' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8fb" />
    <meta name="description" content={siteNameAttribute + ' — 좋은 생각을 오래 쓰이는 경험으로 만듭니다.'} />
    <title>{siteName} — 좋은 생각을 오래 쓰이는 경험으로</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#top" aria-label={siteNameAttribute + ' 홈'}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>{siteName}</span>
        </a>
        <nav class="main-nav" aria-label="주요 메뉴">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="header-cta" href="#contact">이야기 나누기 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero section-shell" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> 생각을 더 나은 경험으로</p>
          <h1 id="hero-title">의미 있는 변화는<br /><span>좋은 시작</span>에서.</h1>
          <p class="hero-description">좋은 생각을 오래 쓰이는 경험으로 만듭니다. 우리가 하는 일과 전하고 싶은 가치를 이곳에서 소개해 보세요.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">우리가 하는 일 <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#about">우리 이야기 <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-note"><span class="note-line"></span><span>작은 시작이 만드는 큰 차이</span></div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-sun"></div>
          <div class="art-card art-card-main">
            <div class="art-card-top"><span class="art-label">A BETTER WAY</span><span class="art-spark">✳</span></div>
            <div class="art-strokes"><i></i><i></i><i></i></div>
            <div class="art-card-bottom"><span>오늘의 작은 발견</span><span class="art-arrow">↗</span></div>
          </div>
          <div class="art-card art-card-float"><span class="float-icon">✳</span><span>MAKE IT<br />MATTER</span></div>
          <div class="art-caption"><span class="caption-dot"></span> BUILT FOR WHAT'S NEXT</div>
        </div>
        <div class="hero-index"><span>01</span><span class="index-rule"></span><span>04</span></div>
      </section>

      <section class="intro-band" aria-label="사이트 소개">
        <div class="section-shell intro-inner">
          <p>좋은 아이디어가<br />사람들의 일상에 닿도록.</p>
          <p class="intro-aside">우리가 믿는 것<br /><span>사람 · 가능성 · 꾸준한 성장</span></p>
          <span class="intro-symbol" aria-hidden="true">✳</span>
        </div>
      </section>

      <section class="content-section section-shell" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">ABOUT US <span class="heading-rule"></span></p>
          <h2 id="about-title">우리는 더 나은 가능성을<br /><span>함께 발견합니다.</span></h2>
        </div>
        <div class="about-copy">
          <p>세상에는 아직 발견되지 않은 좋은 생각이 많습니다. 우리는 그 생각에 귀 기울이고, 필요한 사람에게 닿는 형태로 구체화합니다.</p>
          <p>이 문장을 여러분의 이야기로 바꿔 보세요. 무엇을 믿고, 누구를 위해, 어떤 변화를 만들어 가는지 들려주세요.</p>
          <a class="text-link dark-link" href="#contact">우리와 함께하기 <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-shell">
          <div class="section-heading work-heading">
            <div><p class="eyebrow">WHAT WE DO <span class="heading-rule"></span></p><h2 id="work-title">좋은 생각을<br /><span>현실로 이어가는 방법.</span></h2></div>
            <p class="heading-aside">처음부터 완벽한 답을 찾기보다,<br />함께 더 나은 방향을 만들어 갑니다.</p>
          </div>
          <div class="principle-grid">
            {principles.map((item) => (
              <article class="principle-card">
                <div class="card-meta"><span>{item.number}</span><span class="card-icon" aria-hidden="true">↗</span></div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="insights-section section-shell" id="insights" aria-labelledby="insights-title">
        <div class="section-heading insights-heading">
          <div><p class="eyebrow">FIELD NOTES <span class="heading-rule"></span></p><h2 id="insights-title">생각을 나누고,<br /><span>다음 장면을 엽니다.</span></h2></div>
          <p class="heading-aside">새로운 소식과 배운 점을<br />이 공간에 차곡차곡 담아 보세요.</p>
        </div>
        <div class="story-grid">
          {stories.map((story) => (
            <article class="story-card">
              <div class="story-art" aria-hidden="true"><span class:list={['story-shape', 'shape-' + story.number]}></span><span class="story-number">{story.number}</span></div>
              <div class="story-meta"><span>{story.category}</span><span>콘텐츠 예시</span></div>
              <h3>{story.title}</h3>
              <p>{story.description}</p>
            </article>
          ))}
        </div>
        <p class="content-note">위 글은 화면 구성을 위한 예시입니다. 실제 콘텐츠 링크와 내용으로 교체해 주세요.</p>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-shell contact-inner">
          <div><p class="eyebrow light-eyebrow">LET'S MAKE IT MATTER <span class="heading-rule"></span></p><h2 id="contact-title">다음 이야기를<br /><span>함께 시작해요.</span></h2></div>
          <div class="contact-copy"><p>여러분의 프로젝트, 제품, 아이디어를 소개하고 대화를 시작할 수 있는 문구를 이곳에 적어 보세요.</p><a class="button button-light" href="#contact-details">문의 안내 추가하기 <span aria-hidden="true">↗</span></a><p class="contact-placeholder" id="contact-details">실제 문의 이메일 또는 문의 페이지 링크를 추가해 주세요. 아직 예시 연락처는 설정되어 있지 않습니다.</p></div>
          <span class="contact-stamp" aria-hidden="true">A<br />✳</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell footer-inner">
        <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>{siteName}</span></a>
        <p>좋은 생각을 오래 쓰이는 경험으로.</p>
        <a class="back-top" href="#top">맨 위로 <span aria-hidden="true">↑</span></a>
        <small>© {new Date().getFullYear()} {siteName}. All rights reserved.</small>
      </div>
    </footer>
  </body>
</html>

---
import SiteLayout from '../../components/SiteLayout.astro';
import site from '../../site-data';
import { contentKind, contentTitle, contentDescription, contentSlug, isContentPublic } from '../../content-utils';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../../post-order';
import { getImage } from 'astro:assets';
import '../../styles.css';
const posts = sortPostsNewestFirst(await getCollection('content', (entry) => contentKind(entry) === 'post' && isContentPublic(entry)));
const entries = await Promise.all(posts.map(async (post) => ({post,cover:post.data.cover ? await getImage({src:post.data.cover,format:post.data.cover.format === 'svg' ? 'svg' : 'webp',...(post.data.cover.format === 'svg' ? {} : {width:960})}) : undefined})));
const [featured, ...recent] = entries;
---
<SiteLayout title="소식" description={site.about}>
  <section class="journal-hero"><div class="container journal-hero-inner"><p class="eyebrow">Journal · Ideas · People</p><h1>일과 사람 사이에서<br /><span>발견한 이야기를 나눕니다.</span></h1><p>함께 고민하고 만들어온 과정, 다음 변화를 여는 생각들을 전합니다.</p></div></section>
  <section class="journal-page"><div class="container">
    {featured ? <a class="journal-feature" href={`/blog/${contentSlug(featured.post)}/`}>
      <div class="journal-feature-art" aria-hidden="true"><span>FIELD NOTE / 01</span><i></i><b>관찰에서<br />시작되는 변화</b><small>{site.displayName}</small></div>
      <div class="journal-feature-copy"><p class="section-kicker">From our journal</p><time>{featured.post.data.date instanceof Date ? featured.post.data.date.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric',timeZone:'Asia/Seoul'}) : 'JOURNAL'}</time><h2>{contentTitle(featured.post)}</h2>{contentDescription(featured.post) && <p>{contentDescription(featured.post)}</p>}<span class="journal-read">이야기 읽기 <b aria-hidden="true">↗</b></span></div>
    </a> : <div class="journal-empty-state"><span class="section-kicker">A note for later</span><h2>새로운 이야기를 준비하고 있습니다.</h2><p>곧 이곳에서 다음 소식을 전해드릴게요.</p></div>}
    {recent.length > 0 && <section class="journal-recent"><div class="journal-recent-heading"><p class="section-kicker">More to explore</p><h2>최근 이야기</h2></div><div class="journal-list">{recent.map(({post})=><a class="journal-item" href={`/blog/${contentSlug(post)}/`}><time>{post.data.date instanceof Date ? post.data.date.toLocaleDateString('ko-KR',{year:'numeric',month:'2-digit',day:'2-digit',timeZone:'Asia/Seoul'}) : 'JOURNAL'}</time><div><h3>{contentTitle(post)}</h3>{contentDescription(post) && <p>{contentDescription(post)}</p>}</div><span class="journal-arrow" aria-hidden="true">↗</span></a>)}</div></section>}
  </div></section>
</SiteLayout>

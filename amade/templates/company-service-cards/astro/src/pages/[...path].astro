---
import { contentKind, contentTitle, contentDescription, contentAuthor, contentPath, hasContentHeading, isContentPublic, isContentDeployed } from '../content-utils';
import { getCollection, render } from 'astro:content'; import '../styles.css';
export async function getStaticPaths(){const pages=await getCollection('content',(entry)=>contentKind(entry)==='page'&&isContentPublic(entry));return pages.map(page=>({params:{path:contentPath(page)},props:{page}}));}
const {page}=Astro.props;const {Content}=await render(page);
---
<html lang="ko"><head><meta charset="utf-8"/><title>{contentTitle(page)}</title></head><body><main class="shell"><a href="/">홈</a>{(!hasContentHeading(page) || page.data.title) && <h1>{contentTitle(page)}</h1>}<Content/></main></body></html>

---
import site from '../site-data';
interface Props { title?: string; description?: string; image?: string; }
const { title = site.displayName, description, image } = Astro.props;
const pageTitle = title === site.displayName ? title : `${title} | ${site.displayName}`;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : image;
---
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:site_name" content={site.displayName} />
  <meta property="og:title" content={pageTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  {site.favicon && <link rel="icon" href={site.favicon} />}
  {!site.searchEngineIndexing && <meta name="robots" content="noindex, nofollow" />}
</head>

---
import { contentKind, contentTitle, contentDescription, contentAuthor, contentPath, hasContentHeading, isContentPublic, isContentDeployed } from '../../content-utils';
import { getCollection, render } from 'astro:content'; import '../../styles.css';
export async function getStaticPaths(){const items=await getCollection('content',(entry)=>contentKind(entry)==='service'&&isContentPublic(entry));return items.map(item=>({params:{slug:item.id.split('/').at(-1)},props:{item}}));}
const {item}=Astro.props;const {Content}=await render(item);
---
<html lang="ko"><head><meta charset="utf-8"/><title>{contentTitle(item)}</title></head><body><main class="shell"><a href="/services/">목록</a>{(!hasContentHeading(item) || item.data.title) && <h1>{contentTitle(item)}</h1>}<Content/></main></body></html>

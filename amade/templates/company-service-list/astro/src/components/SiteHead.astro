---
import site from '../site-data';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; author?: string; publishedAt?: string; canonicalUrl?: string; noIndex?: boolean; }
const { title = site.displayName, description, image, imageAlt, type = 'website', author, publishedAt, canonicalUrl, noIndex = false } = Astro.props;
const pageTitle = title === site.displayName ? title : `${title} | ${site.displayName}`;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : image;
const publishedDate = publishedAt ? new Date(publishedAt) : undefined;
const publishedIso = publishedDate && !Number.isNaN(publishedDate.valueOf()) ? publishedDate.toISOString() : undefined;
---
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{pageTitle}</title>{description && <meta name="description" content={description}/>}<meta property="og:site_name" content={site.displayName}/><meta property="og:title" content={pageTitle}/>{description && <meta property="og:description" content={description}/>}<meta property="og:type" content={type}/>{imageUrl && <meta property="og:image" content={imageUrl} />}{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt}/>} {author && <meta name="author" content={author}/>} {publishedIso && <meta property="article:published_time" content={publishedIso}/>} {canonicalUrl && <link rel="canonical" href={canonicalUrl}/>} {site.favicon && <link rel="icon" href={site.favicon}/>} {(!site.searchEngineIndexing || noIndex) && <meta name="robots" content="noindex, nofollow"/>}</head>

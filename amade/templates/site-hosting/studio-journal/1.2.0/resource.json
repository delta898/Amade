  "site_hosting": {
    "schema_version": 1,
    "astro": {
      "source": "astro",
      "build_command": "npm run build",
      "output_directory": "dist"
    },
    "customization": {
      "schema_version": 1,
      "fields": [
        {
          "key": "site_name",
          "type": "string",
          "label": "사이트 이름",
          "default": "스튜디오",
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "name"
          }
        },
        {
          "key": "logo",
          "type": "image",
          "label": "로고",
          "default": "",
          "required": false,
          "target": {
            "file": "src/site-config.json",
            "path": "logo"
          }
        },
        {
          "key": "navigation",
          "type": "navigation",
          "label": "메뉴",
          "default": [
            {
              "label": "소개",
              "href": "/#about"
            },
            {
              "label": "서비스",
              "href": "/#services"
            },
            {
              "label": "이야기",
              "href": "/blog/"
            },
            {
              "label": "문의",
              "href": "/#contact"
            }
          ],
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "navigation"
          }
        }
      ]
    },
    "pages": {
      "schema_version": 1,
      "mode": "static_placeholders",
      "max_items": 12,
      "route_pattern": "/{slug}/",
      "reserved_slugs": [
        "blog"
      ],
      "target": {
        "file": "src/site-config.json",
        "path": "pages"
      }
    },
    "publishing": {
      "schema_version": 2,
      "format": "markdown",
      "content_directory": "src/content/posts",
      "post_layout": {
        "type": "per_post_directory",
        "entry_file": "index.md",
        "assets_directory": "images",
        "image_reference": "entry_relative"
      },
      "frontmatter": [
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "name": "pubDate",
          "type": "date",
          "required": true
        },
        {
          "name": "is_public",
          "type": "boolean",
          "required": false,
          "default": false
        }
      ],
      "visibility": {
        "field": "is_public",
        "published_value": true,
        "default": false
      },
      "routes": {
        "listing": "/blog/",
        "detail": "/blog/{slug}/"
      }
    }
  }
}

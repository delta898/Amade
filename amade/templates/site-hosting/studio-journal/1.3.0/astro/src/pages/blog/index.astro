---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import siteConfig from '../../site-config.json';

const posts = (await getCollection('posts', ({ data }) => data.is_public))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title={`이야기 — ${siteConfig.name}`} description="스튜디오의 소식과 생각을 기록합니다.">
  <div class="page-shell">
    <SiteHeader />
    <main>
      <p class="eyebrow"><span></span> JOURNAL</p>
      <h1>생각과 작업을<br /><em>차곡차곡.</em></h1>
      <p class="intro">새로운 관점과 진행 중인 작업을 기록합니다.</p>
      {posts.length ? <div class="post-list">{posts.map((post) => (
        <a class="post-row" href={`/blog/${post.id}/`}>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <div><h2>{post.data.title}</h2><p>{post.data.description}</p>{post.data.tags.length > 0 && <small>{post.data.tags.join(' · ')}</small>}</div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}</div> : <div class="empty-state"><p>첫 번째 이야기를 준비하고 있습니다.</p><span>새 글을 발행하면 이곳에 표시됩니다.</span></div>}
    </main>
    <footer><a href="/">← 홈으로</a><span>© {new Date().getFullYear()} {siteConfig.name}</span></footer>
  </div>
</BaseLayout>
<style>
  .page-shell { max-width: 1120px; min-height: 100vh; margin: 0 auto; padding: 0 7%; display: flex; flex-direction: column; }
  main { flex: 1; padding: 82px 0 105px; }
  .eyebrow { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 9px; font-weight: 600; letter-spacing: .14em; }
  .eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  h1 { margin: 25px 0 13px; font-family: var(--serif); font-size: clamp(52px, 8vw, 84px); font-weight: 400; line-height: 1.22; letter-spacing: -.07em; }
  h1 em { color: var(--accent); font-weight: 400; }
  .intro { color: var(--muted); font-size: 12px; }
  .post-list { margin-top: 57px; border-top: 1px solid var(--line); }
  .post-row { display: grid; grid-template-columns: 140px 1fr auto; gap: 22px; align-items: center; padding: 25px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .post-row time, .post-row small { color: var(--muted); font-size: 9px; }
  .post-row h2 { margin: 0 0 7px; font-family: var(--serif); font-size: 21px; font-weight: 400; letter-spacing: -.04em; }
  .post-row p { margin: 0 0 8px; color: var(--muted); font-size: 11px; line-height: 1.7; }
  .post-row > span { color: var(--accent); }
  .empty-state { margin-top: 55px; padding: 28px 0; border-top: 1px solid var(--line); }
  .empty-state p { margin-bottom: 7px; font-family: var(--serif); font-size: 20px; }
  .empty-state span { color: var(--muted); font-size: 11px; }
  footer { display: flex; justify-content: space-between; gap: 16px; padding: 22px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 9px; }
  footer a { text-decoration: none; }
  @media (max-width: 640px) { .page-shell { padding: 0 22px; } main { padding: 62px 0 78px; }.post-row { grid-template-columns: 1fr auto; gap: 10px; }.post-row time, .post-row > div { grid-column: 1; }.post-row > span { grid-column: 2; grid-row: 1 / span 2; } }
</style>

---
import siteConfig from '../site-config.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

export function getStaticPaths() {
  return (siteConfig.pages || []).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<BaseLayout title={`${page.label} — ${siteConfig.name}`} description={`${page.label} 페이지입니다.`}>
  <main class="custom-page">
    <SiteHeader />
    <section>
      <p class="eyebrow">PAGE</p>
      <h1>{page.label}</h1>
      <p>이 페이지를 편집해 사이트에 필요한 내용을 채워 보세요.</p>
      <a href="/">홈으로 돌아가기</a>
    </section>
  </main>
</BaseLayout>

<style>
  .custom-page { width: min(100% - 48px, 1160px); margin: 0 auto; }
  section { max-width: 760px; min-height: 56vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; }
  h1 { margin: 12px 0; font-size: clamp(40px, 8vw, 84px); line-height: 1; letter-spacing: -.06em; }
  section > p:not(.eyebrow) { color: var(--muted); line-height: 1.8; }
  section > a { margin-top: 18px; }
</style>

  "site_hosting": {
    "schema_version": 1,
    "astro": {
      "source": "astro",
      "build_command": "npm run build",
      "output_directory": "dist"
    },
    "customization": {
      "schema_version": 1,
      "fields": [
        {
          "key": "site_name",
          "type": "string",
          "label": "사이트 이름",
          "default": "스튜디오",
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "name"
          }
        },
        {
          "key": "logo",
          "type": "image",
          "label": "로고",
          "default": "",
          "required": false,
          "target": {
            "file": "src/site-config.json",
            "path": "logo"
          }
        },
        {
          "key": "navigation",
          "type": "navigation",
          "label": "메뉴",
          "default": [
            {
              "label": "소개",
              "href": "/#about"
            },
            {
              "label": "서비스",
              "href": "/#services"
            },
            {
              "label": "이야기",
              "href": "/blog/"
            },
            {
              "label": "문의",
              "href": "/#contact"
            }
          ],
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "navigation"
          }
        }
      ]
    },
    "pages": {
      "schema_version": 1,
      "mode": "static_placeholders",
      "max_items": 12,
      "route_pattern": "/{slug}/",
      "reserved_slugs": ["blog"],
      "target": { "file": "src/site-config.json", "path": "pages" }
    },
    "publishing": {
      "content_directory": "src/content/posts",
      "route_pattern": "/blog/{slug}/",
      "frontmatter": [
        "title",
        "description",
        "pubDate"
      ]
    }
  }
}

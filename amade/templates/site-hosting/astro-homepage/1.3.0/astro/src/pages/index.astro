---
import config from '../site-config.json';
import '../styles/global.css';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${config.name} 홈페이지`} />
    <title>{config.name}</title>
  </head>
  <body>
    <header><a class="brand" href="/">{config.logo && <img src={config.logo} alt="" />}{config.name}</a><nav>{config.navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav></header>
    <main><p class="eyebrow">ASTRO SITE</p><h1>{config.name}</h1><p class="intro">나만의 사이트를 시작해 보세요.</p><a class="button" href="/blog/">블로그 글 보기</a></main>
    <footer>Powered by Astro · BlogGenius</footer>
  </body>
</html>

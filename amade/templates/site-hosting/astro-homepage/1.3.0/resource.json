{
  "schema_version": 1,
  "id": "astro-homepage",
  "kind": "site-hosting",
  "version": "1.3.0",
  "name": "Astro Homepage",
  "description": "개인 사이트의 첫 화면과 블로그를 간결하게 시작할 수 있는 가벼운 Astro 템플릿입니다.",
  "author": "amadejjs",
  "homepage": "https://www.bloggenius.kr",
  "support": "amadejjs@naver.com",
  "created_at": "2026-10-03",
  "license": "MIT",

    "path": "preview.svg",
    "sha256": "ad3bf170e5993799be317140127fb2a84259b6a98d6a2aeb1dd956e3abd0b308",
    "media_type": "image/svg+xml"
  },
  "compatibility": {
    "astro": "7.3.5",
    "bloggenius": ">=0.5.5"
  },
  "package": {
    "path": ".",
    "files": [
      {
        "path": "astro/LICENSE",

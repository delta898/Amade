      },
      {
        "path": "astro/src/content.config.ts",
        "sha256": "5397eb9e127d4cbe49d5a889123a11a53f9683ae822a7dbafbbab1edbbcf336a",
        "size": 370
      },
      {
        "path": "astro/src/pages/blog/[...slug].astro",
        "sha256": "ba6ec75e8d05275c19a56008735dfe0740b6aed9d7a1928f7081f325f12f9beb",
        "size": 1061
      },
      {
        "path": "astro/src/pages/blog/index.astro",
        "sha256": "f7e126095466e30ebc1d4eeaa485b4f622aff2915ddad3a79b671484ba64207d",

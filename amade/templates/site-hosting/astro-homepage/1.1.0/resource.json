        "sha256": "fdcbb9648b6133979b8c2d46a4ae2a9657fd21ebd01e3a96b79fb62aa46438a7",
        "size": 810
      },
      {
        "path": "astro/src/site-config.json",
        "sha256": "168d001a29e35b8c4c474ec005ca821f591e5acd9d677dc0313a3b3b53666b8e",
        "size": 157
      },
      {
        "path": "astro/src/styles/global.css",
        "sha256": "148525119e00c0ff285d3fbddc8c5b0995f4b7936e9d6380a545795968c7a1ae",
        "size": 1896
      }
    ]
  },
  "site_hosting": {
    "schema_version": 1,
    "astro": {
      "source": "astro",
      "build_command": "npm run build",
      "output_directory": "dist"
    },
    "customization": {
      "schema_version": 1,
      "fields": [
        {
          "key": "site_name",
          "type": "string",
          "label": "사이트 이름",
          "default": "나의 사이트",
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "name"
          }
        },
        {
          "key": "logo",
          "type": "image",
          "label": "로고",
          "default": "",
          "required": false,
          "target": {
            "file": "src/site-config.json",
            "path": "logo"
          }
        },
        {
          "key": "navigation",
          "type": "navigation",
          "label": "메뉴",
          "default": [
            {
              "label": "홈",
              "href": "/"
            },
            {
              "label": "블로그",
              "href": "/blog/"
            }
          ],
          "required": true,
          "target": {
            "file": "src/site-config.json",
            "path": "navigation"
          }
        }
      ]
    },
    "pages": {
      "schema_version": 1,
      "mode": "static_placeholders",
      "max_items": 12,
      "route_pattern": "/{slug}/",
      "reserved_slugs": ["blog"],
      "target": { "file": "src/site-config.json", "path": "pages" }
    },
    "publishing": {
      "content_directory": "src/content/posts",
      "route_pattern": "/blog/{slug}/",
      "frontmatter": [
        "title",
        "description",
        "pubDate"
      ]
    }
  }
}

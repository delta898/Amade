{
  "schema_version": 1,
  "id": "astro-homepage",
  "kind": "site-hosting",
  "version": "1.1.0",
  "name": "Astro Homepage",
  "description": "가벼운 홈페이지와 블로그를 함께 시작하는 Astro 템플릿입니다.",
  "maintainer": "Amade",
  "license": "MIT",

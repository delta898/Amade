---
import { getCollection, render } from 'astro:content';
import config from '../../site-config.json';
import '../../styles/global.css';
export async function getStaticPaths() {
  return (await getCollection('posts', ({ data }) => data.is_public)).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<!doctype html>
<html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{post.data.title} · {config.name}</title><meta name="description" content={post.data.description} /></head>
<body><header><a class="brand" href="/">{config.name}</a><nav>{config.navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav></header><main><a class="back" href="/blog/">← 블로그</a><article class="post"><p class="eyebrow">{post.data.pubDate.toLocaleDateString('ko-KR')}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p><Content /></article></main><footer>Powered by Astro · BlogGenius</footer></body></html>

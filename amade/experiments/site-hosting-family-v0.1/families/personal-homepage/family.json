{
  "spec_version": "0.1.0",
  "family_id": "personal-homepage",
  "site_data_directory": "data",
  "name": "개인 홈페이지",
  "description": "Initial experimental family contract for same-family template switching.",
  "site_profile": {
    "fields": {
      "displayName": { "type": "string", "required": true, "minLength": 1 },
      "headline": { "type": "string", "required": true, "minLength": 1 },
      "biography": { "type": "string", "required": true, "minLength": 1 },
      "logo": { "type": "public-url-path", "required": false, "root": "public/" }
    }
  },
  "navigation": {
    "source": "site.json",
    "minimum_items": 1,
    "identity": "stable item id; labels and paths may be edited",
    "fields": {
      "id": { "type": "string", "required": true, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "unique": true },
      "label": { "type": "string", "required": true, "minLength": 1 },
      "path": { "type": "internal-url-path", "required": true }
    },
    "path_values_survive_same_family_switch": true,
    "path_policy": "one leading slash; no external/protocol-relative URL, query, fragment, backslash, or dot segment"
  },
  "media": {
    "public_directory": "data/public/",
    "entry_directory": "images/",
    "markdown_reference": "./images/<file>",
    "relative_to_entry": true,
    "validated_format": "SVG fixture only; production format/size policy pending"
  },
  "content_types": [
    {
      "kind": "page",
      "source": "data/pages/{id}.md",
      "identity": "stable lowercase ASCII kebab-case filename stem",
      "body_format": "markdown",
      "fields": {
        "kind": { "type": "string", "required": true, "const": "page" },
        "title": { "type": "string", "required": true, "minLength": 1 },
        "path": { "type": "internal-url-path", "required": true },
        "is_public": { "type": "boolean", "required": false, "default": false }
      },
      "public_path": "frontmatter.path"
    },
    {
      "kind": "post",
      "source": "data/posts/{slug}/index.md",
      "identity": "stable lowercase ASCII kebab-case directory slug",
      "body_format": "markdown",
      "fields": {
        "kind": { "type": "string", "required": true, "const": "post" },
        "title": { "type": "string", "required": true, "minLength": 1 },
        "description": { "type": "string", "required": true, "minLength": 1 },
        "pubDate": { "type": "date", "required": true },
        "is_public": { "type": "boolean", "required": false, "default": false }
      },
      "listing_route": "/blog/",
      "detail_route": "/blog/{slug}/"
    },
    {
      "kind": "work",
      "source": "data/work/{slug}/index.md",
      "identity": "stable lowercase ASCII kebab-case directory slug",
      "body_format": "markdown",
      "fields": {
        "kind": { "type": "string", "required": true, "const": "work" },
        "title": { "type": "string", "required": true, "minLength": 1 },
        "description": { "type": "string", "required": true, "minLength": 1 },
        "order": { "type": "integer", "required": false, "minimum": 0 },
        "is_public": { "type": "boolean", "required": false, "default": false }
      },
      "listing_route": "/work/",
      "detail_route": "/work/{slug}/"
    }
  ]
}

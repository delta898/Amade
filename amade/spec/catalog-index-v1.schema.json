{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amade.dev/spec/catalog-index-v1.schema.json",
  "title": "Amade Catalog Index v1",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "name",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "version",
          "revision",
          "manifest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "site-hosting",
              "bloggenius-style"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "manifest": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amade.dev/spec/site-hosting-template-v0.1.schema.json",
  "title": "Amade Site Hosting Template 0.1",
  "allOf": [
    { "$ref": "./common-metadata-v0.1.schema.json" },
    {
      "type": "object",
      "required": ["spec_version", "template_id", "family_id", "astro_project", "site_data", "layout"],
      "properties": {
        "spec_version": { "const": "0.1.0" },
        "compatibility": {
          "properties": {
            "contract": { "properties": { "id": { "enum": ["bloggenius-site-hosting-template", "bloggenius-knowledge-collection-template"] }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } } }
          }
        },
        "template_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "family_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "astro_project": { "$ref": "./common-metadata-v0.1.schema.json#/$defs/packagePath" },
        "site_data": { "type": "string", "pattern": "^(?:\\.\\./){1,3}[A-Za-z0-9._/-]+$" },
        "layout": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  ],
  "unevaluatedProperties": false
}

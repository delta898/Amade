{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amade.dev/spec/resource-v1.schema.json",
  "title": "Amade Resource v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "version",
    "name",
    "description",
    "license",
    "preview",
    "compatibility",
    "package"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "site-hosting",
        "bloggenius-style"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "maintainer": {
      "type": "string",
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "$ref": "#/$defs/file"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "astro": {
          "type": "string"
        },
        "bloggenius": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "path",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "site_hosting": {
      "$ref": "site-hosting-v1.schema.json"
    },
    "bloggenius_style": {
      "$ref": "bloggenius-style-v1.schema.json"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "site-hosting"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "site_hosting"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bloggenius-style"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "bloggenius_style"
        ]
      }
    }
  ]
}
